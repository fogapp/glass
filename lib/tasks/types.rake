# typed: false
# frozen_string_literal: true

# The console's closed vocabularies that mirror backend enums, generated
# rather than copied: `bin/rails glass:types` writes
# frontend/src/types/generated.ts, and bin/ci fails when the committed file
# differs from what the enums say now. `api.get<T>` trusts T; this is how
# the trust stays earned for the vocabularies that grow.
namespace :glass do
  desc "Write frontend/src/types/generated.ts from the backend enums"
  task types: :environment do
    path = Rails.root.join("frontend/src/types/generated.ts")
    path.write(GeneratedTypes.render)
    puts "wrote #{path.relative_path_from(Rails.root)}"
  end
end

module GeneratedTypes
  # constant => [its TypeScript type, its values]: one row per vocabulary,
  # so one can never be added with only half of what it needs.
  VOCABULARIES = {
    # Who a person is in the household, and what an API token may do.
    "USER_ROLES" => [ "UserRole", -> { User::Role.values.map(&:serialize) } ],
    "API_TOKEN_SCOPES" => [ "ApiTokenScope", -> { ApiToken::Scope.values.map(&:serialize) } ],
    "IDENTITY_MODES" => [ "IdentityMode", -> { App::IdentityMode.values.map(&:serialize) } ],
    "LOG_LEVELS" => [ "LogLevel", -> { AgentSettings::LOG_LEVELS } ],
    "MARKER_KINDS" => [ "MarkerKind", -> { Telemetry::Marker::Kind.values.map(&:serialize) } ],
    "QUERY_SHAPES" => [ "QueryShape", -> { Query::Request::Shape.values.map(&:serialize) } ],
    "QUERY_SOURCES" => [ "QuerySource", -> { Query::Sources::ALL.map(&:name) + [ "metrics" ] } ],
    "PAGE_EVENT_KINDS" => [ "PageEventKind", -> { Telemetry::PageEvent::KINDS } ],
    "SPAN_KINDS" => [ "SpanKind", -> { Telemetry::Span::KINDS } ],
    "WORK_FACETS" => [ "WorkFacet", -> { Telemetry::Work::FACETS } ],
    "METRIC_KINDS" => [ "MetricKind", -> { Telemetry::MetricSeries::Kind.values.map(&:serialize) } ],
    "PROFILE_STATES" => [ "ProfileState", -> { Telemetry::ProfileSample::STATES } ],
    "TELEMETRY_TABLES" => [ "TelemetryTable", -> { Telemetry::Tables::ALL.map(&:name) } ],
    # The MCP toolbox, in catalog order: Settings › API tokens describes each
    # tool, and a tool added without a line there fails the frontend build.
    "MCP_TOOLS" => [ "McpTool", -> { Mcp::Toolbox::ALL.map(&:name_value) } ],
    # Triage: what kind of problem a finding is, how bad, and the shapes
    # its evidence comes in — each drawn by the console without knowing
    # which detector made it.
    "TRIAGE_KINDS" => [ "TriageKind", -> { Triage::Kind.values.map(&:serialize) } ],
    "TRIAGE_SEVERITIES" => [ "TriageSeverity", -> { Triage::Severity.values.map(&:serialize) } ],
    "TRIAGE_EVIDENCE_TYPES" => [ "TriageEvidenceType", -> { Triage::Evidence::Type.values.map(&:serialize) } ],
    # A person's answer to a finding: hidden until it gets worse, or for good.
    "TRIAGE_DISMISSAL_MODES" => [ "TriageDismissalMode", -> { TriageDismissal::Mode.values.map(&:serialize) } ],
    # Configuration's own vocabularies: a maintenance job's runs, the
    # activity log, monitors.
    "JOB_RUN_STATUSES" => [ "JobRunStatus", -> { JobRun::Status.values.map(&:serialize) } ],
    "JOB_RUN_TRIGGERS" => [ "JobRunTrigger", -> { JobRun::Trigger.values.map(&:serialize) } ],
    "ACTIVITY_SEVERITIES" => [ "ActivitySeverity", -> { Activity::Severity.values.map(&:serialize) } ],
    "MONITOR_KINDS" => [ "MonitorKind", -> { MonitorRule::Kind.values.map(&:serialize) } ],
    "MONITOR_STATES" => [ "MonitorState", -> { MonitorRule::State.values.map(&:serialize) } ],
    # A dashboard's widgets: a query or a header, and what a header may be.
    "WIDGET_KINDS" => [ "WidgetKind", -> { Dashboard::Kind.values.map(&:serialize) } ],
    "HEADER_SIZES" => [ "HeaderSize", -> { Dashboard::HeaderSize.values.map(&:serialize) } ],
    "HEADER_ICONS" => [ "HeaderIcon", -> { Dashboard::HEADER_ICONS } ],
    # What a chart's header and subheader can be made of.
    "LABEL_PARTS" => [ "LabelPart", -> { Dashboard::LabelPart.values.map(&:serialize) } ]
  }.freeze

  def self.render
    lines = [ "// Generated by `bin/rails glass:types` from the backend enums — do not edit.", "" ]
    VOCABULARIES.each do |constant, (type, values)|
      list = values.call.map { |value| %("#{value}") }.join(", ")
      lines << "export const #{constant} = [#{list}] as const;"
      lines << "export type #{type} = (typeof #{constant})[number];"
      lines << ""
    end
    "#{lines.join("\n").rstrip}\n"
  end
end
