#!/usr/bin/env ruby
# frozen_string_literal: true

# Sets up (or brings up to date) a development checkout, idempotently:
# gems, the console's packages, both databases. Postgres comes from
# `docker compose up -d db`.
#
#   bin/setup              then starts bin/dev
#   bin/setup --demo       also writes a pretend fleet (bin/rails glass:demo)
#   bin/setup --skip-server
require "fileutils"

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir File.expand_path("..", __dir__) do
  puts "== Installing gems =="
  system("bundle check") || system!("bundle install")

  installed = "frontend/node_modules/.package-lock.json"
  if !File.exist?(installed) || File.mtime(installed) < File.mtime("frontend/package-lock.json")
    puts "\n== Installing the console's packages =="
    system! "npm --prefix frontend ci"
  end

  # Creates or migrates primary (from db/schema.rb) and telemetry (its raw
  # SQL migrations — there is no schema file to load or reset from).
  puts "\n== Preparing the databases =="
  system! "bin/rails db:prepare"

  if ARGV.include?("--demo")
    puts "\n== Writing the demo fleet =="
    system! "bin/rails glass:demo"
  end

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting the API and the console (bin/dev) =="
    $stdout.flush # before exec(2), so the output shows
    exec "bin/dev"
  end
end
